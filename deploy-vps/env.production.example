# ─────────────────────────────────────────────────────────────────────────────
# Шаблон переменных окружения для продакшена (VPS / Render).
#
#   cp deploy-vps/env.production.example /opt/v2/app/.env
#   chmod 600 /opt/v2/app/.env
#
# ВНИМАНИЕ по имени файла: он называется `env.production.example`, БЕЗ точки
# в начале. `.gitignore` игнорирует `.env.*` (исключение сделано только для
# `.env.example`), поэтому файл с именем `.env.production.example` в репозиторий
# не попадал — на него ссылалась документация, а самого файла не было.
#
# На Render этот файл не нужен: те же переменные задаются в дашборде
# (Service -> Environment). Держите его как справочник по списку переменных.
# ─────────────────────────────────────────────────────────────────────────────

# ─── База данных ─────────────────────────────────────────────────────────────
# VPS: Postgres из deploy-vps/docker-compose.prod.yml, слушает только localhost.
DATABASE_URL=postgres://v2:ЗАМЕНИТЬ_ПАРОЛЬ@127.0.0.1:5432/english_learning
# Пароль для docker-compose.prod.yml (должен совпадать с DATABASE_URL).
POSTGRES_PASSWORD=ЗАМЕНИТЬ_ПАРОЛЬ

# ─── Авторизация ─────────────────────────────────────────────────────────────
# Секрет подписи JWT. Сгенерировать: openssl rand -base64 48
# Смена значения разлогинивает всех пользователей.
SESSION_SECRET=ЗАМЕНИТЬ_СЛУЧАЙНОЙ_СТРОКОЙ

# ─── Публичный адрес приложения ──────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО. Используется в письмах (подтверждение email, сброс пароля).
# Без него ссылки в письмах превращаются в https://undefined — раньше адрес
# брался из REPLIT_DEV_DOMAIN, которого вне Replit не существует.
APP_URL=https://ваш-домен

# ─── Порты ───────────────────────────────────────────────────────────────────
# VPS: 3000 (Caddy проксирует на 127.0.0.1:3000). Render задаёт PORT сам.
PORT=3000

# ─────────────────────────────────────────────────────────────────────────────
# ОБЪЕКТНОЕ ХРАНИЛИЩЕ (аватары, фото/аудио/видео заданий, записи учеников)
#
# Без него файлы пишутся на локальный диск контейнера. На Render это значит,
# что все загруженные фото и аудио ИСЧЕЗНУТ при следующем деплое: persistent
# disk на бесплатном плане не предусмотрен.
#
# Подходит ЛЮБОЕ S3-совместимое хранилище. Пошаговая настройка с бесплатными
# вариантами (Cloudflare R2, Backblaze B2, MinIO на своём VPS) и обязательным
# правилом CORS: deploy-vps/STORAGE.md
#
# После заполнения проверьте настройку одной командой:
#   node scripts/storage-check.mjs --origin https://ваш-домен
# ─────────────────────────────────────────────────────────────────────────────

# Адрес API хранилища (БЕЗ имени бакета в пути).
#   Cloudflare R2   https://<account_id>.r2.cloudflarestorage.com
#   Backblaze B2    https://s3.us-west-004.backblazeb2.com
#   MinIO на VPS    http://127.0.0.1:9000
S3_ENDPOINT=

# Имя бакета.
S3_BUCKET=

# Ключи доступа к бакету. Нужны права на чтение И запись объектов.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Регион. Для R2 строго auto. Для B2/MinIO/AWS — реальный регион бакета.
S3_REGION=auto

# Стиль адресации. true = бакет в пути (работает у R2, MinIO, B2).
# Переключайте на false, только если провайдер требует virtual-hosted style.
S3_FORCE_PATH_STYLE=true

# Префикс ключей внутри бакета — чтобы в одном бакете можно было держать
# и другие данные. Пустое значение = складывать в корень.
S3_PREFIX=uploads

# ─── Почта: регистрация с подтверждением по email ────────────────────────────
# Ключ из resend.com (Dashboard -> API Keys). Нужен для кода подтверждения при
# регистрации и для писем сброса пароля.
#
# Без ключа регистрация не ломается, но код подтверждения никуда не уходит:
# пользователь остаётся неподтверждённым и фронтенд его разлогинивает.
RESEND_API_KEY=

# Адрес отправителя. ДОМЕН ОБЯЗАН БЫТЬ ПОДТВЕРЖДЁН в Resend (Domains -> Verify),
# иначе каждая отправка падает с «domain is not verified» при верном ключе.
# Можно не задавать — тогда берётся уже подтверждённый домен по умолчанию.
# EMAIL_FROM=English Learning <noreply@ваш-домен>

# ─── Голосовой чат (необязательно) ───────────────────────────────────────────
OPENAI_API_KEY=
# Необязательный прокси/совместимый эндпоинт OpenAI.
# OPENAI_API_BASE=

# ─── Перевод флешкарт (необязательно) ────────────────────────────────────────
# Это НЕ хранилище: ключ Google Cloud Translation Basic (v2) для перевода
# англ->рус. Без него работает встроенный фолбэк.
GOOGLE_TRANSLATE_API_KEY=

# ─── Прочее ──────────────────────────────────────────────────────────────────
# После первого успешного деплоя можно поставить false для быстрого старта
# (схема и сид идемпотентны, поэтому true тоже безопасен).
RUN_DB_SETUP=true

# НЕ задавайте EXPO_PUBLIC_DOMAIN: фронтенд обращается к относительному /api.
# Если задать, домен вшивается в собранный бандл и переезд на другой домен
# ломает приложение.
# EXPO_PUBLIC_DOMAIN=

# Copy this file to .env and adjust if needed:  cp .env.example .env

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/english_learning

# --- Auth ---
# Any non-empty string works for local dev. Change it for anything shared.
SESSION_SECRET=dev-secret-key-change-me

# --- Object storage (avatars, assignment photos/audio/video, recordings) ---
# Leave BLANK for local dev: files then go to the ./uploads folder on disk and
# everything keeps working. In production you need real object storage — on
# Render the container disk is wiped on every deploy, so uploaded media would
# disappear.
#
# Any S3-compatible provider works (Cloudflare R2, Backblaze B2, MinIO,
# Supabase Storage). Step-by-step setup incl. the required CORS rule:
# deploy-vps/STORAGE.md.  Verify with: node scripts/storage-check.mjs
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# "auto" for Cloudflare R2; a real region for B2 / MinIO / AWS.
S3_REGION=auto
# true = bucket in the path (R2, MinIO, B2). Flip only if the provider requires
# virtual-hosted style addressing.
S3_FORCE_PATH_STYLE=true
# Key prefix inside the bucket. Empty = store in the bucket root.
S3_PREFIX=uploads

# --- Optional integrations (leave blank for local testing) ---
# Email verification codes / password reset (https://resend.com). Optional for
# local dev: without it the 6-digit code is only logged, never emailed.
# Accounts WITHOUT an email (teacher-created students) are auto-verified on
# startup; accounts that registered with an email must enter the code.
RESEND_API_KEY=
# Sender address. Its domain must be VERIFIED in Resend, otherwise every send
# fails with "domain is not verified". Defaults to the already-verified domain.
# EMAIL_FROM=English Learning <noreply@your-domain>
# Base url used in password-reset links. Required in production.
# APP_URL=https://your-domain

# --- AI: разговор с тьютором (Google AI Studio / Gemini) ---
# Ключ отсюда: https://aistudio.google.com/apikey
#
# ЕДИНСТВЕННЫЙ обязательный ключ для раздела «Разговор с тьютором»: отвечать
# ученику умеет только модель Gemini. Без него раздел честно сообщает, что не
# настроен, и не показывает заготовленных ответов.
#
# Тем же ключом идут распознавание речи и озвучка ответа (см. src/lib/ai.ts).
GOOGLE_AI_API_KEY=
# Имена моделей у Google меняются чаще, чем выходят наши правки. Эти переменные
# позволяют переехать без коммита — по умолчанию берётся gemini-2.5-flash.
# GOOGLE_AI_CHAT_MODEL=
# GOOGLE_AI_STT_MODEL=
# GOOGLE_AI_TTS_MODEL=
# GOOGLE_AI_TTS_VOICE=Kore

# Flashcards: official Google Cloud Translation Basic API v2 key. Recommended
# for production; enable Cloud Translation API and restrict the key to this API.
GOOGLE_TRANSLATE_API_KEY=

# --- Maintenance tools ---
# Включает служебную страницу «примеры употребления»:
#   /api/maintenance/fill-examples?key=<этот ключ>
# Она заполняет пустые примеры парами из Tatoeba, где и фраза, и перевод
# написаны людьми. Существующие примеры и переводы не меняются — только пустые
# места (подробности в WORDS.md).
#
# ПУСТАЯ переменная = маршрута не существует, сервер отвечает 404. Это
# состояние по умолчанию и оно правильное: инструмент, который пишет в боевую
# базу, не должен быть доступен только потому, что кто-то угадал адрес.
#
# Ключ едет в адресной строке, то есть попадает в историю браузера и логи
# прокси. Поэтому: длинная случайная строка, и меняйте её после работ.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MAINTENANCE_KEY=

# --- Речь: озвучка слов и подстраховка распознавания ---
# Deepgram делает в проекте ДВЕ работы:
#   1) озвучивает слова в карточках (Aura-2, готовый mp3);
#   2) расшифровывает голосовые реплики, когда Gemini не принял формат записи.
#
# Второе важнее, чем кажется: браузер пишет webm (Chrome) или mp4 (Safari), а
# Gemini таких форматов официально не поддерживает и через раз отказывает.
# Deepgram читает их без разговоров, поэтому для голосового разговора на всех
# устройствах этот ключу лучше быть. Ключ: https://console.deepgram.com
DEEPGRAM_API_KEY=
# DEEPGRAM_STT_MODEL=nova-3
# DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Azure Speech TTS (en-US-AriaNeural) — опционально, дополнительный fallback
# для озвучки СЛОВ (в разговоре с тьютором не участвует).
# Get a key at https://portal.azure.com → Cognitive Services → Speech.
# The free tier (F0) allows 500,000 chars/month — more than enough for a school app.
AZURE_SPEECH_KEY=
# Region where your Azure Speech resource is deployed, e.g. eastus, westeurope.
AZURE_SPEECH_REGION=

# Без любого из ключей выше озвучка слов падает на dictionaryapi.dev
# (записи из Wiktionary) для одиночных слов, а словосочетания и идиомы
# остаются без звука: таких записей там просто нет.

# --- Frontend -> backend wiring ---
# Leave EXPO_PUBLIC_DOMAIN UNSET for local dev. The web app then calls "/api"
# on the same origin, which the preview proxy (port 5000) routes to the API.
# EXPO_PUBLIC_DOMAIN=

# NOTE: the dev ports (API 8080, Expo 22710, proxy 5000) are defined in
# scripts/preview-proxy.mjs and scripts/dev.mjs. Open http://localhost:5000
